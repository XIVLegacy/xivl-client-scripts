{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xivlegacy.org/schemas/myplayer_timer_consumers.schema.json",
  "title": "MyPlayer timer consumer report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "gameVersion",
    "extraction",
    "corpus",
    "nativeMapping",
    "summary",
    "directCallsites",
    "receiverDeclarations",
    "occupancyArgumentMap",
    "vocabularySources",
    "scalarConsumerChains",
    "exactReferenceAccounting",
    "unresolved",
    "rejectedInterpretations"
  ],
  "properties": {
    "version": { "const": "1" },
    "gameVersion": { "const": "1.23b" },
    "extraction": { "const": "2012.09.19.0001" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "manifestSha256", "registry", "registrySha256", "napiIndex", "napiIndexSha256", "scriptCount"],
      "properties": {
        "manifest": { "const": "manifests/scripts.json" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "registry": { "const": "lua/registry.json" },
        "registrySha256": { "$ref": "#/$defs/sha256" },
        "napiIndex": { "const": "lua/napi_index.json" },
        "napiIndexSha256": { "$ref": "#/$defs/sha256" },
        "scriptCount": { "const": 2671 }
      }
    },
    "nativeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "occupancySubopcodes", "occupancyInputTransform", "normalBehestSubopcode", "companyBehestSubopcode", "warpRecastSubopcode", "nmRushSubopcode"],
      "properties": {
        "source": { "const": "xivl-decomp:config/s2c_0193_native_state.json" },
        "occupancySubopcodes": { "const": "0x00..0x0f" },
        "occupancyInputTransform": { "const": "subtract one before indexing" },
        "normalBehestSubopcode": { "const": "0x10" },
        "companyBehestSubopcode": { "const": "0x11" },
        "warpRecastSubopcode": { "const": "0x12" },
        "nmRushSubopcode": { "const": "0x16" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directCallsiteCount", "directCallsitesByCallback", "receiverDeclarationCount", "occupancyProvenArgumentCount"],
      "properties": {
        "directCallsiteCount": { "const": 22 },
        "directCallsitesByCallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["_getCompanyBehestTime", "_getNMRushUpdateTime", "_getNormalBehestTime", "_getOccupancyContentsTime", "_getWarpRecastTime"],
          "properties": {
            "_getCompanyBehestTime": { "const": 1 },
            "_getNMRushUpdateTime": { "const": 2 },
            "_getNormalBehestTime": { "const": 1 },
            "_getOccupancyContentsTime": { "const": 17 },
            "_getWarpRecastTime": { "const": 1 }
          }
        },
        "receiverDeclarationCount": { "const": 5 },
        "occupancyProvenArgumentCount": { "const": 16 }
      }
    },
    "directCallsites": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/callsite" }
    },
    "receiverDeclarations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/declaration" }
    },
    "occupancyArgumentMap": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/argumentMap" }
    },
    "vocabularySources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "scalarConsumerChains": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/scalarChain" }
    },
    "exactReferenceAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directCalls", "receiverDeclarations", "registryInlineMetadata", "otherExactStringOrResourceReferences"],
      "properties": {
        "directCalls": { "const": 22 },
        "receiverDeclarations": { "const": 5 },
        "registryInlineMetadata": { "const": 5 },
        "otherExactStringOrResourceReferences": { "const": 0 }
      }
    },
    "unresolved": { "$ref": "#/$defs/nonemptyStrings" },
    "rejectedInterpretations": { "$ref": "#/$defs/nonemptyStrings" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "callsite": {
      "type": "object",
      "required": ["script", "line", "callback", "caller", "luaArityIncludingSelf", "argument", "use"],
      "properties": {
        "script": { "type": "string", "pattern": "^lua/scripts/.+\\.lua$" },
        "line": { "type": "integer", "minimum": 1 },
        "callback": { "enum": ["_getOccupancyContentsTime", "_getNormalBehestTime", "_getCompanyBehestTime", "_getWarpRecastTime", "_getNMRushUpdateTime"] },
        "caller": { "type": "string", "minLength": 1 },
        "luaArityIncludingSelf": { "enum": [1, 2] },
        "argument": { "type": ["integer", "string", "null"] },
        "use": { "type": "string", "minLength": 1 },
        "nativeVectorIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "deterministicArguments": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 1, "maximum": 16 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "callback": { "const": "_getOccupancyContentsTime" } } },
          "then": {
            "properties": {
              "luaArityIncludingSelf": { "const": 2 },
              "argument": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 16 }, { "const": "parameter" }] }
            },
            "oneOf": [
              {
                "properties": { "argument": { "type": "integer" } },
                "required": ["nativeVectorIndex"],
                "not": { "required": ["deterministicArguments"] }
              },
              {
                "properties": { "argument": { "const": "parameter" } },
                "required": ["deterministicArguments"],
                "not": { "required": ["nativeVectorIndex"] }
              }
            ]
          },
          "else": {
            "properties": {
              "luaArityIncludingSelf": { "const": 1 },
              "argument": { "type": "null" }
            },
            "not": {
              "anyOf": [
                { "required": ["nativeVectorIndex"] },
                { "required": ["deterministicArguments"] }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callback", "receiverClass", "script", "line", "cppName"],
      "properties": {
        "callback": { "type": "string" },
        "receiverClass": { "const": "PlayerBaseClass" },
        "script": { "const": "lua/scripts/chara/player/playerbaseclass_u.lua" },
        "line": { "type": "integer", "minimum": 1 },
        "cppName": { "type": "string", "pattern": "^_get.+_cpp$" }
      }
    },
    "argumentMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["luaArgument", "nativeVectorIndex", "callerContexts", "statusTitleEnglish"],
      "properties": {
        "luaArgument": { "type": "integer", "minimum": 1, "maximum": 16 },
        "nativeVectorIndex": { "type": "integer", "minimum": 0, "maximum": 15 },
        "callerContexts": { "$ref": "#/$defs/nonemptyStrings" },
        "statusTitleEnglish": { "type": "string", "minLength": 1 },
        "statusTransformation": { "type": "string", "minLength": 1 }
      }
    },
    "scalarChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callback", "consumers", "presentation"],
      "properties": {
        "callback": { "type": "string" },
        "consumers": { "$ref": "#/$defs/nonemptyStrings" },
        "presentation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
