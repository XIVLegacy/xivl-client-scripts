  "claims": [
    {
      "id": "guildleve-retained-state",
      "support": "GuildleveBaseClass retains identifiers, timing, aim counts, UI states, and marker coordinates; initialization reads guildleve sheet column 21 into timeLimit.",
      "sources": [
        "director/guildleve/guildlevebaseclass.lua:11-456",
        "director/guildleve/guildlevebaseclass.lua:565-572"
      ]
    },
    {
      "id": "guildleve-client-ui",
      "support": "GuildleveBaseClass exposes guildleve-information data and routes retained marker slots. Marker work updates the minimap; marker size depends on the retained aetheryteLocation value.",
      "sources": [
        "director/guildleve/guildlevebaseclass.lua:285-472",
        "director/guildleve/guildlevebaseclass.lua:575-1560"
      ]
    },
    {
      "id": "request-time-and-ui",
      "support": "RequestDirector derives from GuildleveBaseClass, returns literal 20 from getTimeLimit, and supplies request-specific UI and article methods.",
      "sources": ["director/guildleve/requestdirector.lua:1-466"]
    },
    {
      "id": "caravan-retained-ui-fields",
      "support": "CaravanGuardDirector retains finishTime, progressPer, chocobo status and HP arrays, and marker coordinates, then exposes them through UI and map-widget methods.",
      "sources": [
        "director/caravanguard/caravanguarddirector.lua:11-212",
        "director/caravanguard/caravanguarddirector.lua:215-742"
      ]
    },
    {
      "id": "caravan-ui-data-tuples",
      "support": "getUIDataOpen returns finishTime, town, placeStart, placeEnd, name1, name2, and name3 in that order. getUIDataUpdate selector 1 returns progressPer; selector 2 returns chocoboStatus entries 1-3; selector 3 returns chocoboHPStatus entries 1-3.",
      "sources": ["director/caravanguard/caravanguarddirector.lua:333-368"]
    },
    {
      "id": "caravan-widget-values",
      "support": "ChocoboCaravanWidget uses text banks 10051 and 204, writes timer properties including 300 and 120, maps company values 1-3 to icon IDs 833-835, maps movement values 1-5 to named UI commands, and maps HP values 1-3 to named status commands.",
      "sources": [
        "widget/chocobocaravanwidget.lua:39-80",
        "widget/chocobocaravanwidget.lua:82-143"
      ]
    },
    {
      "id": "caravan-npc-selector-branches",
      "support": "PopulaceCaravanManager entry and question paths call isUpperRank with argument 25, ask selector 16 and conditionally 23 in the entry path, and use selector 4 in the question path. PopulaceCaravanGuide.caravanGuardReward branches on raw argument 1 equal to 9, equal to 0, or in 1-5, then on argument 5 greater than or equal to 50 or in the range 40 <= argument 5 < 50. PopulaceCaravanAdviser.adviserSales passes getMoneyOnHand(1000001) to say row 53013 and asks selector 14 with literal 3011317.",
      "sources": [
        "chara/npc/populace/populacecaravanmanager.lua:11-189",
        "chara/npc/populace/populacecaravanguide.lua:20-60",
        "chara/npc/populace/populacecaravanadviser.lua:48-72"
      ]
    },
    {
      "id": "caravan-guard-choice-contract",
      "support": "ChocoboCaravanGuard.getBattalion returns 1. chocoboCommand asks restricted choices, calls ask row 6 with three forwarded arguments only when the first result is 2, then returns both results.",
      "sources": ["chara/npc/monster/chocobo/chocobocaravanguard.lua:3-23"]
    },
    {
      "id": "hamlet-defense-widget-contract",
      "support": "InstanceRaidHamletDefense retains Hamlet and status fields, routes them to the Hamlet execution widget, and asks the score widget from the local clear path when a score is available.",
      "sources": [
        "director/instanceraid/instanceraidhamletdefense.lua:11-193",
        "director/instanceraid/instanceraidhamletdefense.lua:247-570"
      ]
    },
    {
      "id": "content-group-map-open-dispatch",
      "support": "PlayerBaseClass.postMapOpen enumerates the player's groups and calls processMapOpenMessage on each ContentGroupBaseClass whose getDirector() result is non-null.",
      "sources": ["chara/player/playerbaseclass.lua:2699-2726"]
    },
    {
      "id": "content-group-finalize-notification-request",
      "support": "ContentGroupBaseClass._onFinalize requests worldMaster notification 50012 when the local player is a member and the group kind is 30001 or 30006.",
      "sources": ["group/contentgroup/contentgroupbaseclass.lua:343-381"]
    }
  ],
  "rejectedInterpretations": [
    "The directors do not establish server timers, acceptance rules, objective completion, rewards, or authoritative state ownership.",
    "The caravan director does not establish escort movement, enemy waves, routes, or failure rules.",
    "Caravan widget command strings, icon IDs, timer properties, and numeric NPC arguments do not establish their rendered meanings, owner payload semantics, or historical invocation.",
    "The Hamlet director does not establish wave composition, scoring formulas, victory conditions, or rewards.",
    "The content-group scripts do not identify the displayed text for notification 50012 or the event that caused finalization.",
    "No Behest or Skirmish mechanics may be inferred from these director contracts."
  ]
}
